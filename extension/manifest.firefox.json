{
  "manifest_version": 3,
  "name": "ClarkReader",
  "version": "1.2.2",
  "description": "Reads the text you select aloud in the Emma voice, synthesized locally. No text ever leaves this machine.",
  "homepage_url": "https://github.com/CryptoJones/ClarkReader",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8756/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClarkReader"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Read the current selection aloud"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Pause or resume reading"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Stop reading"
    },
    "toggle-maximize": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Maximize or restore the reader window"
    }
  },
  "background": {
    "scripts": [
      "api.js",
      "config.js",
      "player.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clarkreader@thenetwerk.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
